{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_lives",
  "version": 2,
  "kind": "condition",
  "category": "conditions",
  "name": "Lives check",
  "description": "Compares the lives shown on the status bar with a number. The game keeps one less in $0DBE (4 there means 5 lives), which the check adds back.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "comparison",
      "label": "Comparison",
      "type": "enum",
      "options": [
        { "value": "equal", "label": "Equal (==)" },
        { "value": "not_equal", "label": "Not Equal (!=)" },
        { "value": "less", "label": "Less than (<)" },
        { "value": "greater_equal", "label": "Greater or equal (>=)" }
      ],
      "default": "equal"
    },
    {
      "name": "value",
      "label": "Lives (0..99)",
      "type": "number",
      "min": 0,
      "max": 99,
      "format": "dec",
      "default": 1
    }
  ],
  "clobbers": ["A"]
}
