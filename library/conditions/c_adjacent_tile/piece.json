{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_adjacent_tile",
  "version": 1,
  "kind": "condition",
  "category": "conditions",
  "name": "Neighbour block is",
  "description": "True if the block next to this one (above, below, left or right, 1 to 4 blocks away) is, or is not, the chosen Map16 tile. It moves the block position ($98 Y, $9A X) to look and puts it back. Outside the level it reads as tile FFFF.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "direction",
      "label": "Direction",
      "type": "enum",
      "options": [
        { "value": "above", "label": "Above" },
        { "value": "below", "label": "Below" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "above"
    },
    {
      "name": "distance",
      "label": "Distance",
      "type": "enum",
      "options": [
        { "value": 16, "label": "1 block" },
        { "value": 32, "label": "2 blocks" },
        { "value": 48, "label": "3 blocks" },
        { "value": 64, "label": "4 blocks" }
      ],
      "default": 16
    },
    {
      "name": "comparison",
      "label": "Is",
      "type": "enum",
      "options": [
        { "value": "equal", "label": "Equal to" },
        { "value": "different", "label": "Different from" }
      ],
      "default": "equal"
    },
    {
      "name": "tile",
      "label": "Tile",
      "type": "map16",
      "default": 37
    }
  ],
  "clobbers": ["A"]
}
