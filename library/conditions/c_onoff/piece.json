{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_onoff",
  "version": 1,
  "kind": "condition",
  "category": "conditions",
  "name": "ON/OFF switch is",
  "description": "True while the ON/OFF switch is in the chosen position ($14AF: 0 is ON, any other value OFF).",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "position",
      "label": "Position",
      "type": "enum",
      "options": [
        { "value": 0, "label": "ON" },
        { "value": 1, "label": "OFF" }
      ],
      "default": 0
    }
  ],
  "clobbers": ["A"]
}
