{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_bonus_stars",
  "version": 1,
  "kind": "condition",
  "category": "conditions",
  "name": "Bonus stars check",
  "description": "Compares the current player's bonus stars ($0F48 for Mario, $0F49 for Luigi, picked by $0DB3) with a value.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "comparison",
      "label": "Comparison",
      "type": "enum",
      "options": [
        { "value": "equal", "label": "Equal (==)" },
        { "value": "not_equal", "label": "Not Equal (!=)" },
        { "value": "less", "label": "Less than (<)" },
        { "value": "greater_equal", "label": "Greater or equal (>=)" }
      ],
      "default": "greater_equal"
    },
    {
      "name": "value",
      "label": "Bonus stars (0..99)",
      "type": "number",
      "min": 0,
      "max": 99,
      "default": 50
    }
  ],
  "clobbers": ["A", "X"]
}
