{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_events_passed",
  "version": 1,
  "kind": "condition",
  "category": "conditions",
  "name": "Events passed",
  "description": "Compares the number of overworld events the player has triggered ($1F2E) with a value. It is also a levels-beaten counter when every level triggers an event.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "comparison",
      "label": "Comparison",
      "type": "enum",
      "options": [
        { "value": "equal", "label": "Equal (==)" },
        { "value": "not_equal", "label": "Not Equal (!=)" },
        { "value": "less", "label": "Less than (<)" },
        { "value": "greater_equal", "label": "Greater or equal (>=)" }
      ],
      "default": "greater_equal"
    },
    {
      "name": "value",
      "label": "Events (0..255)",
      "type": "number",
      "min": 0,
      "max": 255,
      "default": 1
    }
  ],
  "clobbers": ["A"]
}
