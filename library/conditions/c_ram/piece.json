{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_ram",
  "version": 2,
  "kind": "condition",
  "category": "conditions",
  "name": "RAM check",
  "description": "Compares the byte at a RAM address with a value. An address of the game's RAM ($0000-$1FFF, or $7E0000-$7E1FFF as the RAM maps give it) is read so that SA-1 hacks work too; any other address (free RAM such as $7F0000, or SA-1's $400000) is used as typed.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "address",
      "label": "RAM Address (hex)",
      "type": "number",
      "min": 0,
      "max": 16777215,
      "format": "hex",
      "default": 5295
    },
    {
      "name": "comparison",
      "label": "Comparison",
      "type": "enum",
      "options": [
        { "value": "equal", "label": "Equal (==)" },
        { "value": "not_equal", "label": "Not Equal (!=)" },
        { "value": "less", "label": "Less than (<)" },
        { "value": "greater_equal", "label": "Greater or equal (>=)" }
      ],
      "default": "equal"
    },
    {
      "name": "value",
      "label": "Value (hex)",
      "type": "number",
      "min": 0,
      "max": 255,
      "format": "hex",
      "default": 0
    }
  ],
  "clobbers": ["A"]
}
