{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_button",
  "version": 2,
  "kind": "condition",
  "category": "conditions",
  "name": "Controller button",
  "description": "True while the chosen controller button is held or was just pressed ($15-$18). $15 and $16 count A as B and X as Y, so B and Y are read from controller 1 itself ($0DA2 held, $0DA6 pressed); with two controllers, that is the first one.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "button",
      "label": "Button",
      "type": "enum",
      "options": [
        { "value": "a", "label": "A" },
        { "value": "b", "label": "B" },
        { "value": "x", "label": "X" },
        { "value": "y", "label": "Y" },
        { "value": "l", "label": "L" },
        { "value": "r", "label": "R" },
        { "value": "start", "label": "Start" },
        { "value": "select", "label": "Select" },
        { "value": "up", "label": "Up" },
        { "value": "down", "label": "Down" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "b"
    },
    {
      "name": "mode",
      "label": "Mode",
      "type": "enum",
      "options": [
        { "value": "held", "label": "Held" },
        { "value": "pressed", "label": "Pressed (this frame)" }
      ],
      "default": "held"
    }
  ],
  "clobbers": ["A"]
}
