{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "c_wall",
  "version": 1,
  "kind": "condition",
  "category": "conditions",
  "name": "Mario is blocked",
  "description": "True if Mario is blocked by a wall on the chosen side ($77).",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "side",
      "label": "Side",
      "type": "enum",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "up", "label": "Up (ceiling)" },
        { "value": "down", "label": "Down (floor)" }
      ],
      "default": "right"
    }
  ],
  "clobbers": ["A"]
}
