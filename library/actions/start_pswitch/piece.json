{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "start_pswitch",
  "version": 1,
  "kind": "action",
  "category": "level",
  "name": "Start P-switch",
  "description": "Starts the blue ($14AD) or the silver ($14AE) P-switch timer. It runs down by 1 every 4 frames: 176, the value of a vanilla switch, lasts about 12 seconds. The switch music is not started.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "switch_type",
      "label": "Switch type",
      "type": "enum",
      "options": [
        { "value": 0, "label": "Blue P-switch ($14AD)" },
        { "value": 1, "label": "Silver P-switch ($14AE)" }
      ],
      "default": 0
    },
    {
      "name": "timer",
      "label": "Timer (1 = 4 frames)",
      "type": "number",
      "min": 1,
      "max": 255,
      "default": 176
    }
  ],
  "once": true,
  "clobbers": ["A"]
}
