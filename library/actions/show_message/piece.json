{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "show_message",
  "version": 1,
  "kind": "action",
  "category": "level",
  "name": "Show message",
  "description": "Pops up a message box ($1426). The texts of message 1 and 2 are set per level in Lunar Magic.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "message",
      "label": "Message",
      "type": "enum",
      "options": [
        { "value": 1, "label": "Message 1" },
        { "value": 2, "label": "Message 2" },
        { "value": 3, "label": "Yoshi thanks" }
      ],
      "default": 1
    }
  ],
  "once": true,
  "clobbers": ["A"]
}
