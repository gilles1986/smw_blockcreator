{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "disable_buttons",
  "version": 2,
  "kind": "action",
  "category": "level",
  "name": "Disable buttons",
  "description": "Disables the chosen controller buttons while Mario touches the Block. Clears the inputs for the current frame ($15, $16, $17, $18) and sets the disable mask for the next frame ($0DAA and $0DAC for Player 1, $0DAB and $0DAD for Player 2), preventing running, jumping, spin jumping, fireballs, and other actions.",
  "author": "BlockCreator",
  "slots": "any",
  "params": [
    {
      "name": "b",
      "label": "B (jump)",
      "type": "bool",
      "default": true
    },
    {
      "name": "a",
      "label": "A (spin jump)",
      "type": "bool",
      "default": true
    },
    {
      "name": "y",
      "label": "Y (run, fire)",
      "type": "bool",
      "default": false
    },
    {
      "name": "x",
      "label": "X (run, fire)",
      "type": "bool",
      "default": false
    },
    {
      "name": "select",
      "label": "Select (drop item)",
      "type": "bool",
      "default": false
    },
    {
      "name": "start",
      "label": "Start (pause)",
      "type": "bool",
      "default": false
    },
    {
      "name": "up",
      "label": "Up",
      "type": "bool",
      "default": false
    },
    {
      "name": "down",
      "label": "Down",
      "type": "bool",
      "default": false
    },
    {
      "name": "left",
      "label": "Left",
      "type": "bool",
      "default": false
    },
    {
      "name": "right",
      "label": "Right",
      "type": "bool",
      "default": false
    },
    {
      "name": "l",
      "label": "L (scroll screen)",
      "type": "bool",
      "default": false
    },
    {
      "name": "r",
      "label": "R (scroll screen)",
      "type": "bool",
      "default": false
    }
  ],
  "clobbers": ["A"]
}
