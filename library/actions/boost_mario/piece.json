{
  "$schema": "../../../core/library/piece.schema.json",
  "id": "boost_mario",
  "version": 2,
  "kind": "action",
  "category": "physics",
  "name": "Boost Mario",
  "description": "Pushes Mario: sets or adds to his horizontal speed ($7B) and vertical speed ($7D). Each push has a strength from 0 to 127, in 1/16 pixel per frame. 'Away from the block' follows the side Mario touches: in Top he is pushed up, in Bottom down, in Left, Right and Inside sideways away from the side he is on ($93), in the Top corner both ways. The Cape, Fireball and Wall-run Slots have no side, so nothing is pushed there.",
  "author": "BlockCreator",
  "slots": "mario",
  "params": [
    {
      "name": "mode",
      "label": "Mode",
      "type": "enum",
      "options": [
        {
          "value": 0,
          "label": "Set speed"
        },
        {
          "value": 1,
          "label": "Add to speed"
        }
      ],
      "default": 0
    },
    {
      "name": "x_direction",
      "label": "Horizontal push",
      "type": "enum",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "away",
          "label": "Away from the block"
        },
        {
          "value": "facing",
          "label": "In the direction Mario faces"
        }
      ],
      "default": "none"
    },
    {
      "name": "x_strength",
      "label": "X strength (0..127)",
      "type": "number",
      "min": 0,
      "max": 127,
      "default": 48
    },
    {
      "name": "y_direction",
      "label": "Vertical push",
      "type": "enum",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "up",
          "label": "Up"
        },
        {
          "value": "down",
          "label": "Down"
        },
        {
          "value": "away",
          "label": "Away from the block"
        }
      ],
      "default": "up"
    },
    {
      "name": "y_strength",
      "label": "Y strength (0..127)",
      "type": "number",
      "min": 0,
      "max": 127,
      "default": 96
    }
  ],
  "clobbers": ["A"]
}
